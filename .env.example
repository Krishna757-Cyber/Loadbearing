# AWS
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# AI mode: bedrock | rules | mock
AI_MODE=bedrock

# Storage: local | dynamo
STORAGE=local

# DynamoDB table name (when STORAGE=dynamo)
DYNAMO_TABLE=loadbearing-demo

# MCP server
MCP_PORT=8787
MCP_URL=http://localhost:8787/mcp
NEXT_PUBLIC_MCP_EVENTS_URL=http://localhost:8787/events

# CORS allowed origin for /events
ALLOWED_ORIGIN=http://localhost:3000

# Admin token for protected routes
ADMIN_TOKEN=change-me-in-production

# Acknowledgement deadline in minutes (demo: 2, production: 30)
ACK_MINUTES=2

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Set to "1" for Playwright e2e (exposes window.__LB_DEBUG__)
NEXT_PUBLIC_E2E=
